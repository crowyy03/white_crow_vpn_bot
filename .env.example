# Telegram
BOT_TOKEN=123456:AAAA-replace-me
ADMIN_IDS=123456789
SUPPORT_USERNAME=@support
BOT_USERNAME=my_vpn_bot

# DB
POSTGRES_USER=botuser
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=vpnbot
DATABASE_URL=postgresql+asyncpg://botuser:change_me_strong@db:5432/vpnbot

# Redis
REDIS_URL=redis://redis:6379/0

# Remnawave
REMNAWAVE_API_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=
REMNAWAVE_DEFAULT_SQUAD_UUID=

# Webhooks
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_SECRET=replace_me_with_64_random_chars

# Payment providers (leave empty to disable)
LAVA_API_URL=https://api.lava.ru
LAVA_API_KEY=
LAVA_SHOP_ID=
LAVA_SECRET=
PAYPALYCH_API_TOKEN=
PAYPALYCH_SHOP_ID=
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_API_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Включить фейкового провайдера (мгновенная оплата — для dev/MVP)
PAYMENTS_FAKE_ENABLED=true

# Stars: сколько копеек = 1 ⭐. 200 = 2 ₽ за звезду
STARS_KOPECKS_PER_STAR=200

# Пополнение баланса: лимиты в копейках
TOPUP_MIN_KOPECKS=10000
TOPUP_MAX_KOPECKS=5000000

# Порог "осталось < N дней" для предупреждений
LOW_BALANCE_DAYS_THRESHOLD=3

# При первом пополнении Remnawave-юзер создаётся с большим expire — это сколько лет
BILLING_FAR_FUTURE_YEARS=10

# Trial
TRIAL_DAYS=3
TRIAL_TRAFFIC_GB=10

# Referral
REFERRAL_PERCENT=20

# Misc
LOG_LEVEL=INFO
TZ=Europe/Moscow
